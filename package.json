{
  "name": "rhema",
  "productName": "Rhema",
  "desktopName": "rhema",
  "version": "1.5.10",
  "description": "A word processor for authors — novels, screenplays, and poetry. Distraction-free by default.",
  "homepage": "https://github.com/dark5un/rhema",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:spellcheck": "node --test scripts/spellcheck.test.js",
    "test:dashes": "node --test scripts/dashes.test.js",
    "test:words": "electron scripts/words.e2e.js",
    "test:tabs": "electron scripts/tabs.e2e.js",
    "test:notes": "electron scripts/notes.e2e.js",
    "test:footnotes": "electron scripts/footnotes.e2e.js",
    "test:cover-text": "electron scripts/cover-text.e2e.js",
    "test:caret": "electron scripts/caret.e2e.js",
    "test:manuscript": "electron scripts/manuscript.e2e.js",
    "test:pages": "electron scripts/pages.e2e.js",
    "test:simple": "electron scripts/simple.e2e.js",
    "test:rhema-settings": "electron scripts/rhema-settings.e2e.js",
    "test:poetry": "electron scripts/poetry.e2e.js",
    "test:spellbook": "electron scripts/spellbook.e2e.js",
    "test": "node --test \"scripts/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"scripts/*.test.js\"",
    "lint": "oxlint",
    "release": "node scripts/release.js",
    "bundle": "node scripts/bundle.js",
    "try": "node scripts/try.js",
    "package": "npm run package:mac",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:all": "electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "io.onlyascii.rhema",
    "productName": "Rhema",
    "publish": {
      "provider": "github",
      "owner": "dark5un",
      "repo": "rhema"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "executableName": "rhema",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "A distraction-free word processor for authors",
      "desktop": {
        "entry": {
          "Comment": "Writing for poets — poems, novels, screenplays.",
          "Keywords": "writing;writer;poetry;poem;novel;book;author;manuscript;wordprocessor;"
        }
      },
      "maintainer": "Panagiotis Xynos <panos@onlyascii.io>"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "asarUnpack": [
      "node_modules/dictionary-ro/**",
      "node_modules/dictionary-pt/**",
      "node_modules/dictionary-hu/**",
      "node_modules/dictionary-sv/**"
    ],
    "extraResources": [
      {
        "from": "licenses/dictionary-sv",
        "to": "app.asar.unpacked/node_modules/dictionary-sv"
      },
      {
        "from": "licenses/dictionary-ro",
        "to": "app.asar.unpacked/node_modules/dictionary-ro"
      },
      {
        "from": "licenses/dictionary-pt",
        "to": "app.asar.unpacked/node_modules/dictionary-pt"
      },
      {
        "from": "licenses/hunspell",
        "to": "licenses/hunspell"
      }
    ],
    "files": [
      "**/*",
      "!pocket/**",
      "!dist/**",
      "!Backups/**",
      "!ship/**",
      "!*.md",
      "!.github/**",
      "!scripts/**",
      "!licenses/**",
      "!Claude outputs/**",
      "!dictionaries/**",
      "!locales/_template.json",
      "!node_modules/koffi/build/koffi/{freebsd,linux,musl,openbsd,win32}_*/**",
      "!node_modules/koffi/{src,vendor,doc}/**",
      "!node_modules/@napi-rs/canvas-*/**"
    ],
    "toolsets": {
      "appimage": "1.0.3"
    }
  },
  "author": "Panagiotis Xynos",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.17.0",
    "oxlint": "^1.86.0"
  },
  "dependencies": {
    "@farscrl/hunspell-wasm": "1.0.1",
    "dictionary-de": "^3.0.0",
    "dictionary-el": "^4.0.0",
    "dictionary-en-au": "^3.0.0",
    "dictionary-en-ca": "^3.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-en-us": "^2.2.1",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-hu": "file:dictionaries/hu",
    "dictionary-nl": "^2.0.0",
    "dictionary-pl": "^2.0.0",
    "dictionary-pt": "4.0.0",
    "dictionary-ro": "3.0.0",
    "dictionary-ru": "^3.0.0",
    "dictionary-sv": "4.0.0",
    "electron-updater": "^6.3.9",
    "jszip": "^3.10.1",
    "koffi": "2.16.3",
    "pdfjs-dist": "6.4.299"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
